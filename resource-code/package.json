{
  "name": "skynix-manager",
  "productName": "Skynix Manager",
  "version": "1.0.5",
  "description": "Skynix - League of Legends Custom Skin Manager",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "electron-builder"
  },
  "author": "Herobrine",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.skynix.manager",
    "productName": "Skynix Manager",
    "asar": true,
    "extraResources": [
      {
        "from": "./tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!hashes*.txt"
        ]
      }
    ],
    "asarUnpack": [
      "tools/**"
    ],
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skynix Manager",
      "uninstallDisplayName": "Skynix Manager Kaldır",
      "artifactName": "Skynix-Manager-Setup-${version}.${ext}",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!Skynix Data base Skins/**",
      "!Skynix Data base Skins.rar",
      "!*.rar",
      "!*.zip",
      "!tools/hashes*.txt",
      "!dist/**",
      "!*.bat",
      "!*.ps1",
      "!*.log",
      "!*.md",
      "!icon.ico",
      "!.vscode/**",
      "!userdata/**",
      "!installed/**",
      "!profiles/**",
      "!overlay/**",
      "!Uygulamaları/**",
      "!Manager/**"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "discord-rpc": "^4.0.1",
    "jpeg-js": "^0.4.4",
    "node-unrar-js": "^2.0.2"
  }
}
